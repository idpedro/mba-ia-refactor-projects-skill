@baseUrl = http://localhost:3000
# Senha impressa no boot (ou o valor de ADMIN_PASSWORD)
@adminAuth = admin@fullcycle.com.br:troque-pela-senha-do-boot

### Checkout - sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "123",
  "c_id": 1,
  "card": "5111222233334444"
}

### Relatório financeiro administrativo (admin)
GET {{baseUrl}}/api/admin/financial-report
Authorization: Basic {{adminAuth}}

### Deletar usuário (admin)
DELETE {{baseUrl}}/api/users/1
Authorization: Basic {{adminAuth}}
