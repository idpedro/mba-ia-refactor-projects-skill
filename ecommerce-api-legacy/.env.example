PORT=3000
# Loopback by default. Use 0.0.0.0 to expose the API on every interface.
HOST=127.0.0.1
# ':memory:' (default) resets data on every boot; use a file path to persist.
DB_PATH=:memory:
PAYMENT_GATEWAY_KEY=
# Required for GET /api/admin/financial-report and DELETE /api/users/:id.
# Empty = those routes answer 401 to everyone. Send it as "Authorization: Bearer <token>".
ADMIN_TOKEN=
LOG_LEVEL=info
