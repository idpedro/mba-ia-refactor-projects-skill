# Todas as variáveis são opcionais: `npm start` sobe sem nenhuma delas.
PORT=3000
# Padrão 127.0.0.1. Use 0.0.0.0 apenas para expor a API em todas as interfaces.
HOST=127.0.0.1
# Padrão :memory: (dados reiniciam a cada boot). Um caminho de arquivo persiste os dados.
DB_PATH=:memory:
ADMIN_EMAIL=admin@fullcycle.com.br
# Senhas das contas semeadas. Se ausentes, são geradas e impressas uma vez no boot.
ADMIN_PASSWORD=
SEED_USER_PASSWORD=
