# Chave de assinatura dos tokens. Sem ela, uma chave aleatória é gerada a cada boot.
SECRET_KEY=
# 1 liga o modo debug do Flask (nunca em produção)
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
DATABASE_PATH=loja.db
# Origens permitidas pelo CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# Validade do token em segundos
TOKEN_MAX_AGE=86400
LOG_LEVEL=INFO
AMBIENTE=producao
