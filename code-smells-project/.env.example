# Todas as variáveis são opcionais: `python app.py` sobe sem nenhuma delas.

# Chave de assinatura dos tokens. Sem ela, uma chave aleatória é gerada a cada boot
# (os tokens emitidos deixam de valer ao reiniciar).
SECRET_KEY=

# Senhas das contas criadas pelo seed. Sem elas, senhas aleatórias são geradas
# e exibidas uma única vez no log do boot que cria (ou migra) essas contas.
ADMIN_PASSWORD=
JOAO_PASSWORD=
MARIA_PASSWORD=

# Servidor
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
LOG_LEVEL=INFO

# Lista de origens permitidas para CORS, separadas por vírgula (vazio = nenhuma)
CORS_ORIGINS=

# Banco SQLite
DATABASE_PATH=loja.db

# Validade dos tokens, em segundos
TOKEN_MAX_AGE=86400
