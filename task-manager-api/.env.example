# Obrigatório em produção: chave usada para assinar os tokens de autenticação.
# Sem ela, uma chave aleatória é gerada a cada boot (tokens expiram ao reiniciar).
SECRET_KEY=
# Validade do token em segundos
TOKEN_MAX_AGE=86400
DATABASE_URL=sqlite:///tasks.db
# Ligar o debugger do Flask: FLASK_DEBUG=1 (nunca em produção)
FLASK_DEBUG=0
# Para expor em todas as interfaces, defina HOST=0.0.0.0 explicitamente
HOST=127.0.0.1
PORT=5000
# Origens CORS permitidas, separadas por vírgula
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
