# Todas as variáveis são opcionais: `python app.py` sobe sem nenhuma delas.

# Chave que assina os tokens de login. Sem ela, uma chave é gerada a cada boot
# (os tokens deixam de valer após um restart).
SECRET_KEY=
# Validade do token, em segundos (padrão: 86400 = 24 h).
TOKEN_MAX_AGE=86400

# Banco (padrão: sqlite:///tasks.db, gravado em instance/tasks.db).
DATABASE_URL=sqlite:///tasks.db

# Servidor. HOST=0.0.0.0 expõe em todas as interfaces (opt-in explícito).
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
LOG_LEVEL=INFO
# Origens liberadas para CORS, separadas por vírgula (vazio = nenhuma).
CORS_ORIGINS=

# SMTP para notificar atribuição de tasks. Sem host/usuário/senha, só registra no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT=10

# Senhas das contas semeadas (seed.py e substituição de senhas padrão no boot).
# Vazias = uma senha aleatória por conta, exibida uma única vez no log.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
