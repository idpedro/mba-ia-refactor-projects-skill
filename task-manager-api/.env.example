# Copie para .env e ajuste. Nenhum valor real deve ser versionado.

# Chave que assina os tokens de login. Sem ela, uma chave aleatória é gerada a cada boot.
SECRET_KEY=
# Validade do token em segundos (padrão: 24h)
TOKEN_MAX_AGE=86400

DATABASE_URL=sqlite:///tasks.db

# Servidor: debug desligado e bind local por padrão. HOST=0.0.0.0 expõe em todas as interfaces.
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
LOG_LEVEL=INFO

# SMTP das notificações. Sem SMTP_HOST, os emails só são registrados no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
